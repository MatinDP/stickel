<Window x:Class="Stickel.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fly="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib" xmlns:icons="clr-namespace:Stickel.Desktop.Controls"
        Title="{Binding Title}" Width="1420" Height="920" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen" Language="en-US"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Tahoma" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" Closing="Window_Closing" Loaded="Window_Loaded">
  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
  </Window.InputBindings>
  <Window.Resources>
    <DataTemplate x:Key="AssetTemplate">
      <Border Padding="5" Margin="2,4" CornerRadius="9" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Panel}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource Well}" CornerRadius="4"><Image Source="{Binding ThumbnailPath}" Width="64" Height="52" Stretch="Uniform"/></Border>
          <StackPanel Grid.Column="1" Margin="8,1,0,1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding DisplayInfo}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" FlowDirection="LeftToRight"/></StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid FlowDirection="LeftToRight" ClipToBounds="True">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*" MinHeight="280"/><RowDefinition Height="6"/><RowDefinition Height="228" MinHeight="150"/><RowDefinition Height="35"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="32" Height="32" Background="{DynamicResource Accent}" CornerRadius="9"><TextBlock Text="S" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Stickel" FontWeight="Bold" FontSize="19"/><TextBlock Text="MEDIA TO STICKERS" FontSize="8" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}">
          <Button icons:IconAssist.Kind="file" Content="{DynamicResource New}" Click="New_Click"/><Button icons:IconAssist.Kind="folder-open" Content="{DynamicResource Open}" Click="Open_Click"/><Button icons:IconAssist.Kind="floppy-disk" Content="{DynamicResource Save}" Click="Save_Click"/>
          <Border Width="1" Background="{DynamicResource Line}" Margin="9,12"/>
          <Button icons:IconAssist.Kind="rotate-left" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" AutomationProperties.Name="{DynamicResource Undo}" Width="36" Height="34" Padding="8"/>
          <Button icons:IconAssist.Kind="rotate-right" Command="{Binding RedoCommand}" ToolTip="Ctrl+Shift+Z" AutomationProperties.Name="{DynamicResource Redo}" Width="36" Height="34" Padding="8"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="LanguagePicker" Width="90" SelectionChanged="Language_Changed"><ComboBoxItem Content="فارسی" Tag="fa"/><ComboBoxItem Content="English" Tag="en"/></ComboBox><Button icons:IconAssist.Kind="sun" x:Name="ThemeButton" Click="Theme_Click" MinWidth="80"/><Button icons:IconAssist.Kind="file-export" Content="{DynamicResource Export}" Click="Export_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanEdit}" Padding="22,8"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="14,12,14,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="278" MinWidth="235"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="10"/><ColumnDefinition Width="264" MinWidth="220"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="10" BorderBrush="{DynamicResource SoftEdge}" BorderThickness="1">
        <DockPanel FlowDirection="{Binding UiFlow}"><TextBlock DockPanel.Dock="Top" Text="{DynamicResource Settings}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="14,13"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="7,0,7,12" IsEnabled="{Binding CanEdit}">
            <Expander Header="{DynamicResource Output}" IsExpanded="True"><StackPanel Margin="3,8,3,2">
              <ComboBox SelectedIndex="{Binding ModeIndex}" AutomationProperties.Name="Export mode"><ComboBoxItem Content="{DynamicResource Telegram}"/><ComboBoxItem Content="{DynamicResource Free}"/></ComboBox>
              <TextBlock Text="{DynamicResource Format}" Margin="5,6,5,0" Foreground="{DynamicResource Muted}"/>
              <ComboBox SelectedIndex="{Binding FormatIndex}" AutomationProperties.Name="Output format"><ComboBoxItem Content="WEBM · VP9"/><ComboBoxItem Content="GIF"/><ComboBoxItem Content="MP4 · H.264"/><ComboBoxItem Content="PNG"/><ComboBoxItem Content="WEBP"/></ComboBox>
              <TextBlock Text="{DynamicResource Quality}" Margin="5,7,5,0" Foreground="{DynamicResource Muted}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Slider Value="{Binding Quality}" IsEnabled="{Binding ManualQuality}" AutomationProperties.Name="Output quality"/><TextBlock Grid.Column="1" Text="{Binding Quality, StringFormat={}{0:0}%}" FontSize="11"/></Grid>
              <TextBlock x:Name="QualityNote" Text="{DynamicResource AutoQuality}" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="6,0"/>
              <CheckBox Content="{DynamicResource Mute}" IsChecked="{Binding MuteOutput}" IsEnabled="{Binding ManualAudio}"/><CheckBox Content="{DynamicResource Parts}" IsChecked="{Binding Individual}"/>
              <TextBlock x:Name="StaticNote" Text="{DynamicResource StaticHint}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource Muted}" Margin="6,3"/>
              <Border Background="{DynamicResource Well}" CornerRadius="9" Padding="8" Margin="3,5"><StackPanel><TextBlock Text="{DynamicResource Estimate}" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Estimate}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            </StackPanel></Expander>
            <Expander Header="{DynamicResource Canvas}"><StackPanel Margin="3,8,3,2">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Width}" Margin="5,0"/><TextBox Text="{Binding CanvasWidth, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Canvas width"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Height}" Margin="5,0"/><TextBox Text="{Binding CanvasHeight, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Canvas height"/></StackPanel></Grid>
              <TextBlock Text="{DynamicResource Background}" Margin="5,8,5,2"/><TextBox Text="{Binding Background, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="MP4 background color"/><WrapPanel><Button Content="#16191F" Tag="#16191F" Click="Color_Click"/><Button Content="#FFFFFF" Tag="#FFFFFF" Click="Color_Click"/><Button Content="#00FF00" Tag="#00FF00" Click="Color_Click"/></WrapPanel>
            </StackPanel></Expander>
            <Expander Header="{DynamicResource Crop}" IsExpanded="True"><StackPanel Margin="3,8,3,2" IsEnabled="{Binding HasSelection}">
              <TextBlock Text="{Binding SelectedName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" Margin="5,0,5,6"/>
              <DockPanel><TextBlock Text="{DynamicResource Rotate}" Margin="5,0"/><TextBox Text="{Binding Rotation, UpdateSourceTrigger=LostFocus}" Width="64" AutomationProperties.Name="{DynamicResource Rotate}"/></DockPanel>
              <ComboBox SelectedIndex="{Binding LayoutIndex}" AutomationProperties.Name="Layout mode"><ComboBoxItem Content="{DynamicResource Fit}"/><ComboBoxItem Content="{DynamicResource Fill}"/><ComboBoxItem Content="{DynamicResource Stretch}"/></ComboBox>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><Slider Minimum="10" Maximum="800" Value="{Binding Zoom}" AutomationProperties.Name="Media scale"/><TextBlock Grid.Column="1" Text="{Binding Zoom, StringFormat={}{0:0}%}"/></Grid>
              <WrapPanel><Button icons:IconAssist.Kind="crop-simple" Content="{DynamicResource CropDraw}" Click="DrawCrop_Click"/><Button icons:IconAssist.Kind="arrows-rotate" Content="{DynamicResource ResetCrop}" Click="ResetCrop_Click"/></WrapPanel>
              <WrapPanel><Button Content="1:1" Tag="1" Click="CropPreset_Click"/><Button Content="16:9" Tag="1.7777777778" Click="CropPreset_Click"/><Button Content="9:16" Tag="0.5625" Click="CropPreset_Click"/><Button Content="4:3" Tag="1.3333333333" Click="CropPreset_Click"/></WrapPanel>
              <UniformGrid Columns="2"><StackPanel><TextBlock Text="{DynamicResource CropX}" FontSize="10" Margin="5,0"/><TextBox Text="{Binding CropX, StringFormat=F1}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource CropY}" FontSize="10" Margin="5,0"/><TextBox Text="{Binding CropY, StringFormat=F1}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource CropW}" FontSize="10" Margin="5,0"/><TextBox Text="{Binding CropWidth, StringFormat=F1}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource CropH}" FontSize="10" Margin="5,0"/><TextBox Text="{Binding CropHeight, StringFormat=F1}"/></StackPanel></UniformGrid>
            </StackPanel></Expander>
            <Expander Header="{DynamicResource Watermark}"><StackPanel Margin="3,8,3,2">
              <Button icons:IconAssist.Kind="image" Content="{DynamicResource ChooseWatermark}" Click="Watermark_Click"/><TextBlock Text="{Binding WatermarkName}" TextTrimming="CharacterEllipsis" Margin="6,3" Foreground="{DynamicResource Muted}"/>
              <CheckBox Content="{DynamicResource EnableWatermark}" IsChecked="{Binding WatermarkEnabled}"/>
              <TextBlock Text="{DynamicResource Opacity}" Margin="5,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Slider Value="{Binding Transparency}"/><TextBlock Grid.Column="1" Text="{Binding Transparency, StringFormat={}{0:0}%}"/></Grid>
              <TextBlock Text="{DynamicResource WmSize}" Margin="5,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Slider Minimum="1" Maximum="100" Value="{Binding WatermarkSize}"/><TextBlock Grid.Column="1" Text="{Binding WatermarkSize, StringFormat={}{0:0}%}"/></Grid>
              <UniformGrid Columns="4" FlowDirection="LeftToRight"><Button icons:IconAssist.Kind="arrow-left" AutomationProperties.Name="{DynamicResource Left}" Tag="left" Click="WatermarkMove_Click" ToolTip="{DynamicResource Left}"/><Button icons:IconAssist.Kind="arrow-up" AutomationProperties.Name="{DynamicResource Up}" Tag="up" ToolTip="{DynamicResource Up}" Click="WatermarkMove_Click"/><Button icons:IconAssist.Kind="arrow-down" AutomationProperties.Name="{DynamicResource Down}" Tag="down" ToolTip="{DynamicResource Down}" Click="WatermarkMove_Click"/><Button icons:IconAssist.Kind="arrow-right" AutomationProperties.Name="{DynamicResource Right}" Tag="right" Click="WatermarkMove_Click" ToolTip="{DynamicResource Right}"/></UniformGrid>
            </StackPanel></Expander>
          </StackPanel></ScrollViewer>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SoftEdge}" BorderThickness="1" CornerRadius="10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
          <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Preview}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Bold"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="SelectedMode" Content="{DynamicResource Selected}" IsChecked="True" Checked="PreviewMode_Changed" Foreground="{DynamicResource Text}" Margin="8,0"/><RadioButton x:Name="WholeMode" Content="{DynamicResource Whole}" Checked="PreviewMode_Changed" Foreground="{DynamicResource Text}" Margin="8,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/><Ellipse x:Name="DurationDot" Width="9" Height="9"/></StackPanel></Grid>
          <Grid Grid.Row="1" x:Name="PreviewSpace" Margin="14,0" SizeChanged="Preview_SizeChanged">
            <Border x:Name="PreviewBorder" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Line}">
              <fly:FlyleafHost x:Name="VideoHost" KeyBindings="None" AttachedDragMove="None" AllowDrop="False">
                <Canvas x:Name="Overlay" Background="#01000000" Focusable="True" ClipToBounds="True" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp">
                  <Rectangle x:Name="StillBackground" IsHitTestVisible="False"/>
                  <Image x:Name="StillImage" Stretch="Fill" IsHitTestVisible="False"/>
                  <Image x:Name="WatermarkImage" Stretch="Fill" IsHitTestVisible="False"/>
                  <Rectangle x:Name="CropRectangle" Stroke="#50D6B4" StrokeThickness="2" Fill="#2050D6B4" Visibility="Collapsed" IsHitTestVisible="False"/>
                  <Canvas x:Name="TransformControls"/>
                  <StackPanel x:Name="EmptyPreview" IsHitTestVisible="False"><TextBlock Text="S" FontSize="58" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" FontWeight="Light"/><TextBlock Text="{DynamicResource EmptyPreview}" Foreground="{DynamicResource Muted}" Margin="0,14,0,0" HorizontalAlignment="Center"/></StackPanel>
                </Canvas>
              </fly:FlyleafHost>
            </Border>
          </Grid>
          <StackPanel Grid.Row="2" Margin="10,7,10,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="SeekSlider" Minimum="{Binding SeekMin}" Maximum="{Binding SeekMax}" Value="{Binding Playhead}" ValueChanged="Seek_Changed" IsMoveToPointEnabled="True" AutomationProperties.Name="Playhead"/><TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11" FontFamily="Consolas" Margin="8,0"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight"><Button x:Name="PreviewVolumeButton" Width="34" Height="32" Padding="8" icons:IconAssist.Kind="volume-high" Click="PreviewMute_Click" ToolTip="{DynamicResource MutePreview}" AutomationProperties.Name="{DynamicResource MutePreview}"/><Slider x:Name="PreviewVolumeSlider" Width="82" Minimum="0" Maximum="100" Value="100" IsMoveToPointEnabled="True" ValueChanged="PreviewVolume_Changed" ToolTip="{DynamicResource AudioMonitor}" AutomationProperties.Name="{DynamicResource AudioMonitor}" VerticalAlignment="Center"/><TextBlock x:Name="PreviewVolumeText" Width="34" Text="100%" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextAlignment="Right" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="6,7"/></Style></StackPanel.Resources><Button icons:IconAssist.Kind="backward-step" AutomationProperties.Name="{DynamicResource PrevFrame}" Tag="prev" Click="Transport_Click" ToolTip="{DynamicResource PrevFrame}"/><Button icons:IconAssist.Kind="backward" AutomationProperties.Name="{DynamicResource BackSecond}" ToolTip="{DynamicResource BackSecond}" Tag="back" Click="Transport_Click"/><Button x:Name="PlayButton" icons:IconAssist.Kind="play" AutomationProperties.Name="{DynamicResource Play}" Tag="play" Click="Transport_Click" ToolTip="{DynamicResource Play}"/><Button icons:IconAssist.Kind="stop" AutomationProperties.Name="{DynamicResource Stop}" Tag="stop" Click="Transport_Click" ToolTip="{DynamicResource Stop}"/><Button icons:IconAssist.Kind="forward" AutomationProperties.Name="{DynamicResource ForwardSecond}" ToolTip="{DynamicResource ForwardSecond}" Tag="forward" Click="Transport_Click"/><Button icons:IconAssist.Kind="forward-step" AutomationProperties.Name="{DynamicResource NextFrame}" Tag="next" Click="Transport_Click" ToolTip="{DynamicResource NextFrame}"/></StackPanel><Button x:Name="CenterMediaButton" Grid.Column="2" HorizontalAlignment="Right" Width="36" Padding="8" icons:IconAssist.Kind="bullseye" ToolTip="{DynamicResource Center}" AutomationProperties.Name="{DynamicResource Center}" Tag="center" Click="Transport_Click"/></Grid></StackPanel>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Border Grid.Column="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SoftEdge}" BorderThickness="1" CornerRadius="10">
        <DockPanel FlowDirection="{Binding UiFlow}"><StackPanel DockPanel.Dock="Top" Margin="10,10,10,5"><TextBlock Text="{DynamicResource Media}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="4,3,4,10"/><Button icons:IconAssist.Kind="plus" Content="{DynamicResource Import}" Click="Import_Click" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{DynamicResource EmptyMedia}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="10" Margin="5,6"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="8"><Button icons:IconAssist.Kind="plus" Content="{DynamicResource AddClip}" Click="AddClip_Click" IsEnabled="{Binding CanEdit}"/><Button icons:IconAssist.Kind="trash" Content="{DynamicResource RemoveMedia}" Click="RemoveMedia_Click" IsEnabled="{Binding CanEdit}"/></StackPanel>
          <TabControl x:Name="MediaTabs" Margin="5" FlowDirection="{Binding UiFlow}"><TabItem Header="{DynamicResource Videos}"><ListBox x:Name="VideoList" ItemsSource="{Binding Videos}" ItemTemplate="{StaticResource AssetTemplate}" VirtualizingPanel.ScrollUnit="Item" MouseDoubleClick="Asset_DoubleClick" PreviewMouseMove="Asset_MouseMove" PreviewMouseWheel="MediaList_PreviewMouseWheel"/></TabItem><TabItem Header="{DynamicResource Images}"><ListBox x:Name="ImageList" ItemsSource="{Binding Images}" ItemTemplate="{StaticResource AssetTemplate}" VirtualizingPanel.ScrollUnit="Item" MouseDoubleClick="Asset_DoubleClick" PreviewMouseMove="Asset_MouseMove" PreviewMouseWheel="MediaList_PreviewMouseWheel"/></TabItem></TabControl>
        </DockPanel>
      </Border>
    </Grid>
    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
    <Border Grid.Row="3" Margin="14,2,14,0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource SoftEdge}" BorderThickness="1" CornerRadius="10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Timeline}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding DurationText}" Margin="15,0" FontFamily="Consolas"/><TextBlock Text="{DynamicResource DragHint}" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><icons:FaIcon Kind="magnifying-glass-minus" Width="13" Height="13" Foreground="{DynamicResource Muted}"/><TextBlock Text=" Zoom " FontSize="10" Foreground="{DynamicResource Muted}"/><icons:FaIcon Kind="magnifying-glass-plus" Width="13" Height="13" Foreground="{DynamicResource Muted}"/></StackPanel><Slider Grid.Column="2" x:Name="TimelineZoom" Minimum="25" Maximum="400" Value="100" ValueChanged="TimelineZoom_Changed"/></Grid>
        <ScrollViewer Grid.Row="1" x:Name="TimelineScroll" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,0" AllowDrop="True" Drop="Timeline_Drop" SizeChanged="Timeline_SizeChanged"><Canvas x:Name="TimelineCanvas" HorizontalAlignment="Left" Height="106" Background="{DynamicResource Well}" MouseLeftButtonDown="Timeline_MouseDown"/></ScrollViewer>
        <Grid Grid.Row="2" Margin="9,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasSelection}"><Button icons:IconAssist.Kind="arrow-left" AutomationProperties.Name="{DynamicResource Left}" Click="MoveLeft_Click" ToolTip="{DynamicResource Left}"/><Button icons:IconAssist.Kind="arrow-right" AutomationProperties.Name="{DynamicResource Right}" Click="MoveRight_Click" ToolTip="{DynamicResource Right}"/><Button icons:IconAssist.Kind="trash" Content="{DynamicResource DeleteClip}" Click="DeleteClip_Click"/><TextBlock Text="{DynamicResource TrimIn}" FontSize="11" Margin="12,0,0,0"/><TextBox x:Name="TrimIn" Width="68" AutomationProperties.Name="Trim in seconds"/><TextBlock Text="{DynamicResource TrimOut}" FontSize="11" Margin="7,0,0,0"/><TextBox x:Name="TrimOut" Width="68" AutomationProperties.Name="Trim out or image duration seconds"/><Button icons:IconAssist.Kind="scissors" Content="{DynamicResource ApplyTrim}" Click="ApplyTrim_Click"/></StackPanel>
          <Button Grid.Column="1" icons:IconAssist.Kind="folder-open" Content="{DynamicResource ShowFolder}" Click="OutputFolder_Click"/>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="4" Margin="16,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/><ProgressBar Grid.Column="1" Value="{Binding Progress, Mode=OneWay}" Height="4" Margin="10,0" VerticalAlignment="Center"/><Button Grid.Column="2" icons:IconAssist.Kind="xmark" Content="{DynamicResource Cancel}" Click="Cancel_Click" Padding="8,1" MinHeight="24" IsEnabled="{Binding IsBusy}"/></Grid>
  </Grid>
</Window>
